rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      // Public can read only published posts. The admin (you) can also
      // read drafts — needed for the admin post list and slug-uniqueness
      // checks, which query across all posts regardless of published state.
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.uid == "YOUR_ADMIN_UID");

      // Only the signed-in admin (you) can create/update/delete.
      // Replace YOUR_ADMIN_UID with your Firebase Auth user UID
      // (Authentication > Users tab in the Firebase console).
      allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID";

      // Anyone can bump the view counter on a published post — but only
      // that one field, and only upward by exactly 1 at a time.
      allow update: if resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])
        && request.resource.data.views == resource.data.views + 1;
    }
  }
}
