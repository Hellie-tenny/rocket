rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      // Public can read only published posts.
      allow read: if resource.data.published == true;

      // Only the signed-in admin (you) can create/update/delete.
      // Replace YOUR_ADMIN_UID with your Firebase Auth user UID
      // (Authentication > Users tab in the Firebase console).
      allow write: if request.auth != null && request.auth.uid == "o4SEhLGosAVha1U3CFzsQ5eAcRP2";
    }
  }
}
